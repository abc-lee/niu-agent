          "task_id"
        ]
      },
      "visibility": "hidden"
    },
    {
      "server": "scheduler-server",
      "name": "update_task",
      "description": "更新定时任务。\n\n参数：\n- task_id: 任务ID\n- content: 新的任务内容（可选）\n- scheduled_at: 新的触发时间（可选）\n- cron_expr: 新的 cron 表达式（可选）\n\n返回：更新结果",
      "input_schema": {
        "type": "object",
        "properties": {
